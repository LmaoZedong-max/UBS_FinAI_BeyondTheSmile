# Python / build artefacts
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Node (only relevant if Docker context is ever set to repo root)
node_modules/
frontend/node_modules/
frontend/dist/

# Version control
.git/
.gitignore

# Editor / tooling
